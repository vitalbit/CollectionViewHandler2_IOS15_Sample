<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:main="clr-namespace:CollectionViewHandler2_IOS15_Sample"
             x:Class="CollectionViewHandler2_IOS15_Sample.CarouselViewPage"
             x:Name="This">
    <Grid RowDefinitions="50, *"
        BindingContext="{Binding Source={Reference This}}"
        x:DataType="main:CarouselViewPage">
        <Label Text="Carousel View Page"
            Grid.Row="0"/>
        <CarouselView ItemsSource="{Binding ImagesToDisplay}"
            Grid.Row="1">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Image Source="{Binding .}"/>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>