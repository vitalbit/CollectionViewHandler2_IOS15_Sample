<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionViewHandler2_IOS15_Sample.MainPage"
             xmlns:main="clr-namespace:CollectionViewHandler2_IOS15_Sample"
             x:Name="This">

    <Grid RowDefinitions="50, *"
        BindingContext="{Binding Source={Reference This}}"
        x:DataType="main:MainPage">
        <Label Text="Main Page"
            Grid.Row="0"/>
        <CollectionView ItemsSource="{Binding ImagesToDisplay}"
            Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Image Source="{Binding .}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
