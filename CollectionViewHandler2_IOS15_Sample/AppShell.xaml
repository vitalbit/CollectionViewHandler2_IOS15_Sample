<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CollectionViewHandler2_IOS15_Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CollectionViewHandler2_IOS15_Sample"
    Shell.FlyoutBehavior="Flyout"
    Title="CollectionViewHandler2_IOS15_Sample">

    <ShellContent
        Title="CollectionView"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <ShellContent
        Title="CarouselView"
        ContentTemplate="{DataTemplate local:CarouselViewPage}"
        Route="CarouselViewPage" />

</Shell>
